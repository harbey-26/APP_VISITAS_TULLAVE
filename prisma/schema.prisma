generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  password   String
  name       String
  phone      String?   // Celular del agente — aparece en el mensaje de confirmación al cliente
  role       String    @default("AGENT") // AGENT, ADMIN
  tokenVersion Int     @default(0) // A8: revocación de sesiones — se incrementa al cambiar la contraseña; los JWT con versión vieja quedan inválidos
  createdAt  DateTime  @default(now())
  lastLat        Float?
  lastLng        Float?
  lastSeenAt     DateTime?
  connectedSince DateTime?
  fcmToken       String?         // legado — reemplazado por UserFcmToken
  visits         Visit[]
  locationLogs   LocationLog[]
  broadcastReads BroadcastRead[]
  fcmTokens      UserFcmToken[]  // M6: soporte multi-dispositivo
  broadcasts     Broadcast[]     // M7: notificaciones dirigidas
  contracts      Contract[]      // C1: contratos diligenciados
  liquidaciones    Liquidacion[]     // L1: liquidaciones creadas
  pagosLiquidacion LiquidacionPago[] @relation("pagosLiquidacion") // L1: pagos que registró
  fichasIncremento FichaIncremento[] // I1: fichas de incremento a su cargo
  solicitudesCreadas   Solicitud[]  @relation("solicitudesCreadas")   // S1
  solicitudesAsignadas Solicitud[]  @relation("solicitudesAsignadas") // S1: su bandeja
  actuacionesSolicitud SolicitudActuacion[]                           // S1
}

model UserFcmToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt  // M6: detectar tokens inactivos para limpieza

  @@index([userId])
  @@index([updatedAt])
}

model LocationLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Broadcast {
  id        Int             @id @default(autoincrement())
  title     String
  body      String
  createdAt DateTime        @default(now())
  userId    Int?            // M7: null = masivo (todos), set = personal (solo ese agente)
  user      User?           @relation(fields: [userId], references: [id])
  reads     BroadcastRead[]

  @@index([userId])
}

model BroadcastRead {
  id          Int       @id @default(autoincrement())
  broadcastId Int
  userId      Int
  seenAt      DateTime  @default(now())
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  @@unique([broadcastId, userId])
  @@index([userId])
}

model Property {
  id        Int      @id @default(autoincrement())
  address   String
  client    String
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
  visits    Visit[]
  contracts Contract[] // C1
  solicitudes Solicitud[] // S1
}

model Visit {
  id               Int       @id @default(autoincrement())
  userId           Int
  propertyId       Int
  scheduledStart   DateTime
  estimatedDuration Int      // In minutes
  status           String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, MISSED, CANCELLED
  type             String    // SHOWING, APPRAISAL, INSPECTION
  actualStart      DateTime?
  actualEnd        DateTime?
  checkInLat       Float?
  checkInLng       Float?
  checkOutLat      Float?
  checkOutLng      Float?

  notes            String?
  outcome          String?
  cancelReason     String?   // Motivo que da el agente al cancelar (status CANCELLED)
  clientName       String?
  clientPhone      String?
  clientEmail      String?    // Correo del cliente — invita al evento de Google Calendar
  modality         String    @default("ON_SITE") // ON_SITE (presencial), PHONE (captación por llamada)
  confirmedAt      DateTime?  // Fecha en que el asesor confirmó la cita con el cliente (WhatsApp)
  deletedAt        DateTime?  // A2: Soft delete — null = activa, fecha = eliminada
  googleEventId    String?    // M8: id del evento sincronizado en Google Calendar

  user      User     @relation(fields: [userId], references: [id])
  property  Property @relation(fields: [propertyId], references: [id])
  images    VisitImage[]
  contracts Contract[] // C1

  @@index([userId])
  @@index([propertyId])
  @@index([scheduledStart])
}

// M8: Tokens OAuth para integraciones (single-row: una cuenta corporativa por kind)
model IntegrationToken {
  id           Int      @id @default(autoincrement())
  kind         String   @unique  // "google_calendar"
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scope        String?
  accountEmail String?
  calendarId   String?  @default("primary")
  updatedAt    DateTime @updatedAt
}

model VisitImage {
  id      Int    @id @default(autoincrement())
  visitId Int
  url     String

  visit Visit @relation(fields: [visitId], references: [id])
}

// C1: Contratos diligenciados por agentes (Administración / Arrendamiento).
// data = JSON serializado con los campos del formulario (SQLite no soporta Json en Prisma 5).
// El PDF no se almacena: se regenera bajo demanda desde data.
model Contract {
  id         Int       @id @default(autoincrement())
  type       String    // ADMINISTRACION, ARRENDAMIENTO
  status     String    @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED, SENT
  data       String    // JSON con los campos del formulario
  userId     Int       // agente que lo diligenció
  visitId    Int?      // visita de origen (pre-llenado), opcional
  propertyId Int?      // inmueble asociado, opcional
  shareToken String?   @unique // token del link público de descarga (fase 2)
  reviewNote String?   // comentario del admin al aprobar/rechazar
  reviewedBy Int?      // id del admin que revisó
  reviewedAt DateTime?
  sentAt     DateTime?
  emailedAt  DateTime? // último envío por correo exitoso (anti-duplicado, 1 h)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  visit       Visit?       @relation(fields: [visitId], references: [id])
  property    Property?    @relation(fields: [propertyId], references: [id])
  liquidacion Liquidacion? // L1
  fichaIncremento FichaIncremento? // I1
  solicitudes Solicitud[] // S1

  @@index([userId])
  @@index([status])
}

// L1: Liquidación inicial de un contrato de arrendamiento (reemplaza el Excel).
// data = JSON serializado: { origen (snapshot del contrato, bloqueado en UI),
// config (fechas/días/derechos/estudio/póliza/abonos/otros), totales (congelados
// al aprobar — fuente del PDF final) }. Al aprobar se convierte en la cuenta por
// cobrar: los pagos van en LiquidacionPago y al saldarse pasa a PAID.
// "Enviada al cliente" NO es estado: queda en sentAt + shareToken.
model Liquidacion {
  id         Int       @id @default(autoincrement())
  status     String    @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED, REOPENED, PAID
  data       String    // JSON: { origen, config, totales? }
  contractId Int       @unique // 1:1 — una liquidación inicial por contrato
  userId     Int       // agente que la creó
  shareToken String?   @unique // link público del PDF para el cliente
  reviewNote String?   // comentario del admin al aprobar/devolver
  reviewedBy Int?
  reviewedAt DateTime?
  sentAt     DateTime? // primera vez que se compartió (WhatsApp/correo)
  emailedAt  DateTime? // último envío por correo exitoso (anti-duplicado, 1 h)
  paidAt     DateTime? // cuando los pagos cubrieron el total
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  contract Contract          @relation(fields: [contractId], references: [id])
  user     User              @relation(fields: [userId], references: [id])
  pagos    LiquidacionPago[]

  @@index([userId])
  @@index([status])
}

// I1: Ficha de incremento — el contrato de arrendamiento "vivo" que el módulo
// de incrementos vigila. Se alimenta de tres vías: alta automática al aprobar
// un contrato ARRENDAMIENTO en la app, backfill de los ya aprobados y carga
// masiva CSV de los contratos históricos (Wasi) que no están en el sistema.
// canonActual es el canon VIGENTE (se actualiza al aplicar cada incremento).
model FichaIncremento {
  id                  Int      @id @default(autoincrement())
  contractId          Int?     @unique // contrato de la app; null = importado (CSV/manual)
  userId              Int?     // agente responsable; null = gestión de oficina (admin)
  codigoWasi          String?
  arrendatarioNombre  String
  arrendatarioCedula  String?
  arrendatarioEmail   String?
  arrendatarioCelular String?
  direccion           String?  // dirección completa del inmueble (para la carta)
  fechaInicioContrato String   // "YYYY-MM-DD" — de aquí sale el aniversario
  canonActual         Int      // COP sin centavos — canon vigente hoy
  tipoIndice          String   @default("IPC") // IPC, IPC_PLUS (IPC + puntos), FIJO (% pactado)
  puntosAdicionales   Float    @default(0) // solo IPC_PLUS: IPC + estos puntos
  pctFijo             Float    @default(0) // solo FIJO: % pactado en el contrato
  activa              Boolean  @default(true) // false = contrato terminado, sale del radar
  notas               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  contract    Contract?    @relation(fields: [contractId], references: [id])
  user        User?        @relation(fields: [userId], references: [id])
  incrementos Incremento[]

  @@index([userId])
  @@index([activa])
}

// I1: Un incremento anual de una ficha (el evento). @@unique(fichaId, periodo)
// impide dos tareas para el mismo aniversario. `data` congela el snapshot de la
// carta al enviarla (evidencia inmutable: el PDF se regenera idéntico aunque la
// ficha cambie después). Los campos de envío son de trazabilidad: no se editan.
model Incremento {
  id               Int       @id @default(autoincrement())
  fichaId          Int
  periodo          Int       // año de aplicación (aniversario que cae en ese año)
  fechaEfectiva    String    // "YYYY-MM-DD" — desde cuándo rige el nuevo canon
  canonAnterior    Int       // COP — canon sobre el que se calcula
  indicePct        Float?    // % aplicado (congelado al generar la carta)
  nuevoCanon       Int?      // canonAnterior × (1 + indicePct/100), peso exacto
  status           String    @default("PENDIENTE") // PENDIENTE, ENVIADA, APLICADA, ANULADA
  data             String?   // JSON: snapshot de la carta al enviar (inmutable)
  cartaEnviadaAt   DateTime? // trazabilidad del envío (no editable)
  enviadaPor       Int?      // id del usuario que envió
  enviadaPorNombre String?   // nombre al momento del envío (sobrevive a cambios)
  enviadaA         String?   // correo destinatario del envío
  shareToken       String?   @unique // link público del PDF de la carta
  emailedAt        DateTime? // último envío por correo exitoso (anti-duplicado, 1 h)
  aplicadoAt       DateTime? // cuándo se aplicó el nuevo canon a la ficha
  aplicadoPor      Int?
  anuladoMotivo    String?   // motivo si status = ANULADA
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  ficha FichaIncremento @relation(fields: [fichaId], references: [id], onDelete: Cascade)

  @@unique([fichaId, periodo])
  @@index([status])
  @@index([fechaEfectiva])
}

// S1: Centro de Solicitudes — cada solicitud es un expediente independiente
// con radicado único, responsable, estado (máquina en solicitudFlow.js),
// línea de tiempo inmutable (SolicitudActuacion) y adjuntos en base64
// (SolicitudAdjunto, mismo criterio que las fotos de visita). `data` guarda el
// JSON específico del tipo (reparación, servicios públicos, derecho de
// petición, terminación). Propietario/arrendatario van como datos del
// solicitante + links opcionales a Property/Contract (no existen como entidad).
model Solicitud {
  id                  Int       @id @default(autoincrement())
  radicado            String    @unique // "SOL-2026-0001" — consecutivo por año
  tipo                String    // clave de SolicitudTipo
  estado              String    @default("RECIBIDA") // RECIBIDA, EN_REVISION, EN_GESTION, PENDIENTE_TERCERO, FINALIZADA, ARCHIVADA
  prioridad           String    @default("MEDIA") // ALTA, MEDIA, BAJA
  medioIngreso        String    // WHATSAPP, CORREO, LLAMADA, PRESENCIAL, OTRO
  asunto              String
  descripcion         String?
  solicitanteNombre   String
  solicitanteTipo     String?   // PROPIETARIO, ARRENDATARIO, TERCERO
  solicitanteTelefono String?
  solicitanteEmail    String?
  propertyId          Int?
  contractId          Int?
  creadaPor           Int       // quien radicó
  responsableId       Int?      // funcionario asignado (bandeja)
  fechaVencimiento    String?   // "YYYY-MM-DD" — término legal o compromiso
  data                String?   // JSON específico del tipo de solicitud
  shareToken          String?   @unique // link público (PDF de liquidación de servicios)
  emailedAt           DateTime? // último envío por correo exitoso (anti-duplicado, 1 h)
  finalizadaAt        DateTime? // para tiempo promedio de respuesta (#40)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  property    Property?            @relation(fields: [propertyId], references: [id])
  contract    Contract?            @relation(fields: [contractId], references: [id])
  creador     User                 @relation("solicitudesCreadas", fields: [creadaPor], references: [id])
  responsable User?                @relation("solicitudesAsignadas", fields: [responsableId], references: [id])
  actuaciones SolicitudActuacion[]
  adjuntos    SolicitudAdjunto[]

  @@index([estado])
  @@index([responsableId])
  @@index([tipo])
  @@index([createdAt])
}

// S1: Línea de tiempo del expediente (#38). Inmutable: no hay update/delete.
// meta = JSON con detalles de la actuación (estado anterior/nuevo, etc.).
model SolicitudActuacion {
  id          Int      @id @default(autoincrement())
  solicitudId Int
  tipo        String   // CREACION, ESTADO, ASIGNACION, NOTA, ADJUNTO, AUTOMATIZACION, RESPUESTA, ALERTA
  descripcion String
  userId      Int?     // null = actuación del sistema (cron)
  meta        String?  // JSON
  createdAt   DateTime @default(now())

  solicitud Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])

  @@index([solicitudId])
}

// S1: Adjuntos del expediente (#39) en base64 (dataUrl), como las fotos de
// visita — sin storage externo. Límite de tamaño en el controlador.
model SolicitudAdjunto {
  id          Int      @id @default(autoincrement())
  solicitudId Int
  nombre      String
  mimeType    String
  size        Int      // bytes del archivo original
  categoria   String   @default("OTRO") // FOTO, FOTO_ANTES, FOTO_DESPUES, FACTURA, COTIZACION, ACTA, CORREO, PDF, OTRO
  dataUrl     String   // data:mime;base64,...
  subidoPor   Int
  // #60: visible para el solicitante en su portal (lo marca el equipo; los
  // archivos subidos por el propio cliente y los de la respuesta nacen en true)
  paraCliente Boolean  @default(false)
  createdAt   DateTime @default(now())

  solicitud Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  @@index([solicitudId])
}

// S1: Tipos de solicitud administrables (#35). Se siembran los 11 del epic;
// el admin puede crear más o desactivar los que no use.
model SolicitudTipo {
  id     Int     @id @default(autoincrement())
  clave  String  @unique // REPARACIONES, SERVICIOS_PUBLICOS, ...
  label  String
  activo Boolean @default(true)
  orden  Int     @default(0)
}

// I1: IPC (o índice) aplicable por año de aplicación. Lo configura el admin:
// "los incrementos de 2026 usan 5,20%" (IPC del año anterior según el DANE).
model IndiceAnual {
  id        Int      @id @default(autoincrement())
  anio      Int      @unique // año de APLICACIÓN de los incrementos
  pct       Float    // variación anual del IPC, en %
  fuente    String?  // ej.: "DANE — IPC 2025"
  updatedAt DateTime @updatedAt
}

// P1: Portal de Clientes — códigos OTP de acceso por correo. El código nunca
// se guarda en claro (hash SHA-256); expira a los 10 minutos y admite máximo
// 5 intentos de verificación. El portal es un frontend aparte (repo
// PORTAL_CLIENTES_TULLAVE) que consume solo las rutas /api/portal/*.
model PortalOtp {
  id        Int       @id @default(autoincrement())
  email     String    // normalizado en minúsculas
  codeHash  String
  expiresAt DateTime
  intentos  Int       @default(0)
  usadoAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// P1: constancia de aceptación de la Política de Tratamiento de Datos
// Personales (Ley 1581 de 2012). Se registra al solicitar el código de acceso
// del portal — una fila por correo: primera aceptación + última + contador.
model PortalConsentimiento {
  id         Int      @id @default(autoincrement())
  email      String   @unique // normalizado en minúsculas
  aceptadaAt DateTime @default(now()) // primera aceptación (prueba del consentimiento)
  ultimaAt   DateTime @updatedAt // última vez que marcó la casilla
  veces      Int      @default(1)
}

// L1: Pagos (abonos) registrados contra una liquidación aprobada. Tabla propia
// y no JSON: son movimientos financieros con auditoría (quién y cuándo).
model LiquidacionPago {
  id            Int      @id @default(autoincrement())
  liquidacionId Int
  valor         Int      // COP sin centavos
  fecha         DateTime // fecha del pago según quien lo registra
  nota          String?
  registradoPor Int
  createdAt     DateTime @default(now())

  liquidacion Liquidacion @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  registrador User        @relation("pagosLiquidacion", fields: [registradoPor], references: [id])

  @@index([liquidacionId])
}
